rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Cada usuario solo puede leer y escribir SU propio documento.
    match /usuarios/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Buzón de contacto: un usuario con sesión puede crear su propio mensaje.
    // Nadie puede leerlos, editarlos ni borrarlos desde la app: la dueña los
    // consulta desde la consola de Firebase o con el SDK admin.
    match /mensajes/{msgId} {
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.mensaje is string
                    && request.resource.data.mensaje.size() > 0
                    && request.resource.data.mensaje.size() <= 1000;
      // Solo la dueña (por su correo) puede leer y borrar los mensajes.
      allow read, delete: if request.auth != null
                          && request.auth.token.email == 'ckarem@gmail.com';
      allow update: if false;
    }

    // Todo lo demás queda cerrado por defecto.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
